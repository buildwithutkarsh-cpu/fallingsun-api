PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/hackathon
JWT_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000

# EASIEST (free, no credit card): Apps Script web app inside your sheet, see apps-script/Code.gs
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# OR Google Cloud service account (needs a Cloud project)
# Google Sheet (one file, tabs: Leaders, Jury, optional Trial, optional Settings)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SHEET_SYNC_SECONDS=60

# Login codes are emailed with Resend (https://resend.com). Empty = code is printed in the console (dev only)
RESEND_API_KEY=
MAIL_FROM=Hackathon Voting <onboarding@resend.dev>

# Local testing without Google: point to a JSON file (see sheet.example.json)
# LOCAL_SHEET_FILE=./sheet.example.json
